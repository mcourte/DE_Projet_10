        <!-- ========== TACHES + TESTS ========== -->

        <!-- TACHE 1 : Extraction -->
        <mxCell id="t1" value="TACHE 1 : Extraction&#xa;(Python pandas)&#xa;&#xa;Lecture des 3 Excel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5c3a00;strokeColor=#ffaa00;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
