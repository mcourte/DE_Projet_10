        </mxCell>

        <!-- TACHE 2 : Nettoyage -->
        <mxCell id="t2" value="TACHE 2 : Nettoyage + Dedoublonnage&#xa;(Python pandas)&#xa;&#xa;ERP : dedup product_id (825)&#xa;LIAISON : dedup product_id (825)&#xa;WEB : drop sku NaN (1428) puis dedup sku (714)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5c3a00;strokeColor=#ffaa00;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="280" height="100" as="geometry"/>
        </mxCell>
        <!-- TEST 1 : unicite cles primaires (invariant) -->
        <mxCell id="test1" value="TEST 1&#xa;Unicite PK&#xa;product_id / sku" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5c0000;strokeColor=#ff5555;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="120" height="80" as="geometry"/>
        </mxCell>
        <!-- TEST 2 : completude (invariant) -->
